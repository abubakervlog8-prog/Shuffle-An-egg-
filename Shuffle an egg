--// CLEAR ESP
local function ClearESP()
    for _,v in ipairs(ESPList) do
        pcall(function() v:Destroy() end)
    end

    table.clear(ESPList)

    local Base = workspace:FindFirstChild("Base")
    if not Base then return end

    for _,v in ipairs(Base:GetDescendants()) do
        if v.Name == "ShuffleEggMiniESP" then
            pcall(function() v:Destroy() end)
        end
    end
end

--// CALCULATE TARGET
local function GetTarget(sequence)

    local position = 2

    for _,move in ipairs(sequence) do

        if move == "Shuffle1"
        or move == "Shuffle2" then

            if position == 2 then
                position = 3
            elseif position == 3 then
                position = 2
            end

        elseif move == "Shuffle3"
        or move == "Shuffle4" then

            if position == 1 then
                position = 2
            elseif position == 2 then
                position = 1
            end

        elseif move == "Shuffle5"
        or move == "Shuffle6" then

            if position == 1 then
                position = 3
            elseif position == 3 then
                position = 1
            end

        end
    end

    return position
end

--// FIND CUP
local function FindCup(number)

    local Base = workspace:FindFirstChild("Base")
    if not Base then return nil end

    for _,base in ipairs(Base:GetChildren()) do

        if base:GetAttribute("Owner")
        == Player.Name then

            local DealerContainer =
                base:FindFirstChild("DealerContainer")

            local Dealer =
                DealerContainer
                and DealerContainer:FindFirstChild(
                    "Lucky Dealer"
                )

            local Cups =
                Dealer
                and Dealer:FindFirstChild("Cups")

            local Skin =
                Cups
                and Cups:FindFirstChild("SKIN")

            local Cup =
                Skin
                and Skin:FindFirstChild(
                    "Cup"..tostring(number)
                )

            if Cup then
                return Cup
            end
        end
    end

    return nil
end

--// RGB ESP
local function MakeESP(Cup)

    if not ESPOn or not Cup then
        return
    end

    local Highlight = Instance.new("Highlight")

    Highlight.Name = "ShuffleEggMiniESP"
    Highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.FillTransparency = .2
    Highlight.OutlineTransparency = 0
    Highlight.Parent = Cup

    table.insert(ESPList,Highlight)

    task.spawn(function()

        while Highlight.Parent and not Dead do

            if RGBOn then

                local hue =
                    (tick()*RGBSpeed/5)%1

                Highlight.FillColor =
                    Color3.fromHSV(
                        hue,1,1
                    )

                Highlight.OutlineColor =
                    Color3.fromHSV(
                        (hue+.5)%1,1,1
                    )

            else

                Highlight.FillColor =
                    Color3.fromRGB(
                        0,255,190
                    )

                Highlight.OutlineColor =
                    Color3.new(1,1,1)

            end

            task.wait(.03)
        end
    end)
end

--// SHUFFLE EVENT
Connections.Shuffle =
    Handshake.OnClientEvent:Connect(
        function(action,data)

            if Dead then return end

            if action == "ShuffleSequence"
            and type(data) == "table"
            and type(data.Sequence) == "table" then

                ClearESP()

                local target =
                    GetTarget(data.Sequence)

                local names = {
                    [1] = "LEFT",
                    [2] = "MIDDLE",
                    [3] = "RIGHT"
                }

                Target.Text =
                    "🎯 "..(names[target] or "?").." CUP"

                Status.Text =
                    "● SHUFFLE DETECTED\nTarget found"

                local Cup = FindCup(target)

                if Cup then
                    MakeESP(Cup)
                end

            elseif action == "RevealResult" then

                task.delay(1.5,function()

                    if Dead then return end

                    ClearESP()

                    Target.Text =
                        "🎯 TARGET: NONE"

                    Status.Text =
                        "● READY\nWaiting..."

                end)
            end
        end
    )

